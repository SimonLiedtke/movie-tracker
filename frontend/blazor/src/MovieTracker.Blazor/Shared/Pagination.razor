@if (PageCount > 1)
{
    <nav class="pagination is-centered mt-5" role="navigation" aria-label="pagination">
        <button class="pagination-previous" disabled="@(Page <= 1)" @onclick="() => OnPageChange.InvokeAsync(Page - 1)">
            Previous
        </button>
        <button class="pagination-next" disabled="@(Page >= PageCount)" @onclick="() => OnPageChange.InvokeAsync(Page + 1)">
            Next
        </button>
        <ul class="pagination-list">
            @foreach (var number in Pages())
            {
                <li>
                    @if (number is null)
                    {
                        <span class="pagination-ellipsis">&hellip;</span>
                    }
                    else
                    {
                        var target = number.Value;
                        <button class="pagination-link @(target == Page ? "is-current" : null)"
                                aria-current="@(target == Page ? "page" : null)"
                                @onclick="() => OnPageChange.InvokeAsync(target)">
                            @target
                        </button>
                    }
                </li>
            }
        </ul>
    </nav>
}

@code {
    [Parameter, EditorRequired] public int Page { get; set; }

    [Parameter, EditorRequired] public int PageSize { get; set; }

    [Parameter, EditorRequired] public int TotalCount { get; set; }

    [Parameter] public EventCallback<int> OnPageChange { get; set; }

    private int PageCount => PageSize <= 0 ? 0 : (int)Math.Ceiling(TotalCount / (double)PageSize);

    /// <summary>First, last, and the pages around the current one; null marks a gap.</summary>
    private List<int?> Pages()
    {
        var result = new List<int?>();
        for (var p = 1; p <= PageCount; p++)
        {
            if (p == 1 || p == PageCount || Math.Abs(p - Page) <= 1)
            {
                result.Add(p);
            }
            else if (result[^1] is not null)
            {
                result.Add(null);
            }
        }

        return result;
    }
}
