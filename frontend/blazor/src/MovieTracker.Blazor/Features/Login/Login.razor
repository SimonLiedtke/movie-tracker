@page "/"
@attribute [PublicPage]
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Sign in · Movie Tracker</PageTitle>

<section class="hero is-medium">
    <div class="hero-body has-text-centered">
        <p class="title is-1">🎬 Movie Tracker</p>
        <p class="subtitle">
            Keep a diary of the movies you watch, rate them, and plan what to watch next.
        </p>

        @if (!string.IsNullOrEmpty(LoginError))
        {
            <div class="notification is-warning is-light mx-auto" style="max-width: 32rem" role="alert">
                Signing in did not work or was cancelled. Please try again.
            </div>
        }

        @* target="_top": the browser goes to the API (the Google sign-in), not Blazor's router. *@
        <a class="button is-medium is-primary" href="@LoginUrl" target="_top">
            <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 48 48" width="20" height="20">
                    <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z" />
                    <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
                    <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" />
                    <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z" />
                </svg>
            </span>
            <span>Sign in with Google</span>
        </a>
    </div>
</section>

@code {
    /// <summary>Where to go after signing in.</summary>
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    /// <summary>Whether the last attempt failed.</summary>
    [SupplyParameterFromQuery] public string? LoginError { get; set; }

    private string LoginUrl => AuthService.LoginUrl(AuthService.IsLocalPath(ReturnUrl) ? ReturnUrl : null);

    protected override void OnInitialized()
    {
        // Signed-in users go straight to where they wanted to go.
        if (Auth.SignedIn)
        {
            Navigation.NavigateTo(AuthService.IsLocalPath(ReturnUrl) ? ReturnUrl! : "/movies", replace: true);
        }
    }
}
