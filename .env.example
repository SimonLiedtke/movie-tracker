# Copy to .env (which git ignores) and fill in. Used by docker-compose.yml.

# Google sign-in. Add http://localhost:8080/api/auth/callback/google as authorized redirect URI
# of the OAuth client (adjust the port if you change APP_PORT).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TMDB movie search: the "API Read Access Token" from https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=
TMDB_LANGUAGE=en-US

# Port of the app on this machine.
APP_PORT=8080

# Database password. Only takes effect when the database volume is created for the first time.
POSTGRES_PASSWORD=movie_tracker
